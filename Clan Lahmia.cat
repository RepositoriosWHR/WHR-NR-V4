              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad que lo porte obtiene un bonificador extraordinario de +1 al resultado del combate si su bando supera en Potencia de unidad al bando enemigo.</characteristic>
              </characteristics>
