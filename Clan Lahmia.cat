              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que la unidad que porta el estandarte restaure miniaturas por un efecto de invocación, tira dos veces los dados y elige el resultado mayor.</characteristic>
              </characteristics>
