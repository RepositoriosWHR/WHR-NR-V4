      </constraints>
      <rules>
        <rule id="3b51-4f22-778c-f06f" name="Asalto imparable" hidden="false">
          <description>Por cada herida no salvada que el Coloso necrolítico cause en combate cuerpo a cuerpo, puede realizar inmediatamente un ataque adicional. Estos ataques adicionales no generan nuevos ataques.</description>
        </rule>
        <rule id="00f1-4316-648a-ac39" name="Poder de Sangre" hidden="false">
          <description>Durante cualquier turno en el que un Coloso necrolítico haya realizado una carga exitosa (o al siguiente turno si arrasó y se trabó en combate) el Coloso necrolítico tiene un bonificador de +1 a su tirada para impactar en combate cuerpo a cuerpo.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="a8f9-5557-7696-bcfd" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
