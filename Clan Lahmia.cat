    <selectionEntry id="6370-4134-8b82-8932" name="Señora de vampiros Lahmia" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="ca4f-bb5c-076b-2a3b" name="Magia Señora de vampiros Lahmia" hidden="false">
          <description>Es una hechicera de nivel 2 que puede convertirse en hechicero de nivel 3 por +50 puntos. Puede elegir sus hechizos de uno (y solo uno) de los Saberes de la Muerte, las Sombras, Magia Oscura o Nigromancia.</description>
        </rule>
      </rules>
