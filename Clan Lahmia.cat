              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco lahmiano. Tiene la regla especial Francotirador y sus impactos se resuelven con Fuerza 5.</characteristic>
              </characteristics>
            </profile>
