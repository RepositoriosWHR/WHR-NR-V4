    <selectionEntry id="3423-456a-5a63-57c5" name="[E] - Imentet, Señora suprema de las Doncellas de Neferata" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9cf6-d282-2fc2-6741" type="max"/>
      </constraints>
      <rules>
        <rule id="878f-3224-44d3-0628" name="Golpe letal (sólo cuerpo a cuerpo)" hidden="false"/>
        <rule id="cef3-82b1-7ade-ee9b" name="Señora de las Doncellas de Neferata" hidden="false">
          <description>Imentet tiene la regla especial ¡Ni un paso atrás! que afecta a todas las unidades del Clan Lahmia; su alcance  aumenta a 18” mientras esté montada en un Trono de Aquelarre.</description>
        </rule>
        <rule id="9a74-cccb-48d4-57d4" name="Trono sangriento" hidden="false">
          <description>Si Imentet monta un Trono del Aquelarre aumenta en 6” el alcance de todas las plegarias que lance, y puede utilizar su regla Sacerdote con el Cuenco de las visiones.</description>
        </rule>
        <rule id="3736-f366-c738-84b9" name="Señora del Templo de la Sangre" hidden="false">
          <description>Imentet conoce todas las plegarias del Templo de la Sangre, y puede lanzar hasta dos de ellas por fase de magia propia con nivel de energía 5, o hasta tres de ellas por fase de magia con nivel de energía 3 cada una.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f05a-a664-6fbb-c136" name="No Muerto (1)" hidden="false" targetId="467a-3f64-3c89-09ba" type="rule"/>
        <infoLink id="4790-c855-7bbf-d21c" name="Vampiro" hidden="false" targetId="ef7d-bb0c-0d9e-f678" type="rule"/>
        <infoLink id="ba16-1b4b-78f1-3572" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="e52a-f7bb-5fb2-a60d" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
        <infoLink id="33c2-0e94-8586-c488" name="Sacerdote" hidden="false" targetId="1fc6-22eb-3dba-dae7" type="rule"/>
      </infoLinks>
      <categoryLinks>
