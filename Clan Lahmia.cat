          <profiles>
            <profile id="e229-c794-431b-15e9" name="Forma espectral" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampiresa es etérea.p</characteristic>
              </characteristics>
