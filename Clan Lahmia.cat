    <selectionEntry id="6cf3-bf2f-6a5f-2d10" name="Vampiro (Clan Lahmia)" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f688-764a-6e58-f6ce" type="max"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5e1a-329b-06c6-5e08" type="min"/>
      </constraints>
      <rules>
        <rule id="2515-e3bd-095d-c2c9" name="Vampiro (Clan Lahmia)" hidden="false">
          <description>Las miniaturas y unidades con la regla especial Vampiro (Lahmia) tienen las siguientes reglas especiales adicionalmente a las que otorga la regla Vampiro: Los enemigos que ataquen a una vampiresa Lahmia en combate cuerpo a cuerpo tendrán un penalizador de -1 en sus tiradas para impactar contra la Lahmia; esto no afecta a miniaturas con la regla especial No muerto o Demonio. Además, las vampiras Lahmia tienen la regla especial Esquivar (5+); sin embargo, nunca podrán equiparse con Armaduras mundanas o mágicas. Además, una Lahmia montada podrá seguir utilizando su tirada de Esquivar, aunque con un penalizador de -1 (si va montada en Pesadilla podrá utilizarla sin penalizador).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="15fe-8dae-2020-cb09" name="Esquivar (5+)" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
      </infoLinks>
