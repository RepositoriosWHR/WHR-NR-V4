    <selectionEntryGroup id="cc14-1618-5b88-d0a8" name="Poderes vampíricos del clan Lahmia. Poder mayor. General" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="adff-26b5-60e4-2136" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="3114-25de-af68-52d3" name="Reina de la noche" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="f8ea-5562-e124-ef5b" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3317-d311-98c7-58eb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1d5c-df15-6ea4-03b0" type="max"/>
          </constraints>
          <profiles>
            <profile id="f396-6414-a175-4012" name="Reina de la noche" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Sólo General del ejército. Al inicio de la batalla, antes del despliegue, elige una unidad enemiga y tira 1D6: si obtienes un resultado de 6, esa unidad ha quedado embaucada (ver más adelante); si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 5+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 4+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 3+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 2+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y ésta quedará embaucada. Una unidad embaucada no despliega en el campo de batalla, sino que deberá utilizar la regla de Refuerzos. Tan solo podrá entrar por un segmento de borde dentro de su propia área de despliegue.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c12a-d19d-7038-2113" name="Armas mágicas. Reliquia. Clan Lahmia. Arma de mano" hidden="false" collective="false" import="true">
