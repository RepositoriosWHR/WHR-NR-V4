              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink id="44d4-de2a-aff4-6fe6" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)(Siervo de los muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
