            <profile id="3321-7ad2-da0e-d5dd" name="Dagas de Qu’aph" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los ataques con estas dagas se resuelven con un bonificador de +1 Fuerza y la regla especial Ataques envenenados. </characteristic>
