        <selectionEntry id="dfd7-aa7f-ba92-8c8e" name="Reflejos sobrenaturales" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cedf-71d6-419f-2c24" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="87eb-51cc-2c7d-b051" type="max"/>
          </constraints>
          <profiles>
            <profile id="349c-b796-820e-866c" name="Reflejos sobrenaturales" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampiresa tiene la regla especial Esquivar (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1c3b-3d1b-2d15-00dd" name="Esquivar (4+)" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
