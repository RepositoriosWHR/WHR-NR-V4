    <selectionEntryGroup id="28e2-a2bc-e16f-843e" name="Objetos hechizados. Clan Lahmia" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1849-ab80-73de-a652" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3b2b-ed98-0ca9-2dbc" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="6fc7-17e1-3942-7a08" name="Relicario de la muerte" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="79f7-30e2-c15b-db4d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4888-578e-4106-e769" type="max"/>
          </constraints>
          <profiles>
            <profile id="c73d-21ae-106a-c5fd" name="Relicario de la muerte" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 1D3+1. Contiene un hechizo de Daño directo que toma como objetivo a una única miniatura enemiga a 12” o menos del lanzador (puedes seleccionar un personaje en una unidad si lo deseas). El hechizo causa un impacto automático de Fuerza 5 que no permite tirada de salvación por armadura. Si causa una herida, el lanzador puede recuperar inmediatamente una de las heridas que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="54e1-aa39-f702-c229" name="Dedo siniestro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b33b-3b93-05a0-22b9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d53d-1a85-fdec-446d" type="max"/>
          </constraints>
          <profiles>
            <profile id="1ab8-373a-d514-160e" name="Dedo siniestro" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 2. Contiene el hechizo Danza macabra de Vanhel (en su versión no potenciada) del Saber de Nigromancia.</characteristic>
              </characteristics>
            </profile>
            <profile id="4973-0a62-6b28-4bab" name="[1] - Danza macabra de Vanhel" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">6+</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto que se encuentre a 18” o menos del lanzador. Si la unidad se encuentra trabada en cuerpo a cuerpo, repetirá sus tiradas para impactar en combate cuerpo a cuerpo hasta el inicio de la siguiente fase de magia propia. De no estarlo, podrá realizar inmediatamente un movimiento como si se encontrase en la sub-fase de Resto de movimientos de su fase de movimiento, una carga como si se encontrase en la sub-fase de declaración de cargas de su fase de movimiento o disparar como si se encontrase en la fase de disparo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3c2d-83e8-25b7-7336" name="Amuleto de huesos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4cd2-402f-0259-0255" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e245-3e78-6ce9-00f7" type="max"/>
          </constraints>
          <profiles>
            <profile id="f4ed-e696-3f7f-f0a4" name="Amuleto de huesos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 2. Contiene el hechizo Invocación de Nehek (en su versión no potenciada) del Saber de Nigromancia.</characteristic>
              </characteristics>
            </profile>
            <profile id="2b3b-0ff1-d6e9-5bd1" name="[0] - Invocación de Nehek" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">5+</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 18” o menos del lanzador. La unidad restaura un Dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="589a-9d82-0ac1-5d41" name="Objetos hechizados. Reliquias. Clan Lahmia. General" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1f45-1ae8-da0d-0f6e" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ff9-305f-4d93-d1b6" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="5c8b-5df4-44bd-ab3e" name="La Corona de Lamashizarr" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="917c-ea70-b037-c5ca" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="672d-dd9c-b068-9405" type="max"/>
          </constraints>
          <profiles>
            <profile id="c1f2-5df4-142c-afec" name="La Corona de Lamashizarr" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo general del ejército. El alcance de la Presencia inspiradora del portador aumenta en 6”. El alcance de los hechizos que lance el portador también aumenta en 6” (los hechizos que afecten a todas las unidades a una distancia del lanzador aumentan dicho radio en 3”). Por último, las unidades amigas dentro del radio de la presencia inspiradora del portador que fallen un chequeo de desmoralización sufrirán una herida menos de lo que indique el resultado del chequeo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="140f-9ac1-d7e4-a2d5" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c276-6433-a171-0ca9" name="Talismanes mágicos. Clan Lahmia" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="10f7-2bd1-6746-bad3" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e6f9-1a95-1c21-a6c1" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="63b7-487d-3d01-6e19" name="Anillo de la noche" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d2e6-3f68-17a4-f8b9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="42af-bc93-0cd2-b962" type="max"/>
          </constraints>
          <profiles>
            <profile id="4033-2016-64b8-f0c9" name="Anillo de la noche" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Todas las tiradas para impactar exitosas en cuerpo a cuerpo contra el portador deberán repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="70ed-15d8-d814-99b5" name="Gema vampírica" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="55ce-d279-1a2d-a37a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1aa9-d3aa-f366-30c3" type="max"/>
          </constraints>
          <profiles>
            <profile id="6433-6845-e6c7-d89d" name="Gema vampírica " hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un sólo uso. Puede utilizarse tras haber fallado una tirada de salvación por armadura o especial en combate cuerpo a cuerpo. Tira 1D6: si obtienes un resultado de 2+, la herida la sufrirá la miniatura enemiga que la causó (y no podrá efectuar tirada de salvación por armadura o especial contra esa herida). Sin embargo, si obtienes un 1, la gema no tiene efecto y la herida causada se convierte en dos heridas para el portador. Ten en cuenta que aunque sufras varias heridas de un mismo ataque, la gema sólo te podrá proteger de una de ellas (a tu elección).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b3f7-4ddf-0ce8-8f54" name="Colgante de Lapislázuli" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="99f5-b11e-3d26-f2e6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4057-56e9-d95c-91d8" type="max"/>
          </constraints>
          <profiles>
            <profile id="d691-13a5-d78f-a815" name="Colgante de Lapislázuli" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Mejora la tirada de salvación por Esquiva de la portadora en +1 hasta un máximo de 3+ (o de 4+ si se trata de una miniatura con potencia de unidad 5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="6f37-f613-26df-70b6" name="Armas mágicas. Clan Lahmia. Armas emparejadas" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="743d-e94f-af24-7ce1" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="af2d-d095-017f-82b6" type="min"/>
      </constraints>
      <selectionEntries>
