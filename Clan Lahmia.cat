          <profiles>
            <profile id="ef83-4355-7557-b335" name="Estandarte de los túmulos" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Tumularios, Caballería tumularia o Señor tumulario. Todos los tumularios de la unidad obtienen un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo. </characteristic>
              </characteristics>
