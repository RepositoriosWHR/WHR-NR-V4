          </costs>
        </selectionEntry>
        <selectionEntry id="3ee2-c8e8-7b4f-4a91" name="Ojo de halcón" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="11a2-f001-8e18-b09d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1697-357a-2b67-f0fe" type="max"/>
          </constraints>
          <profiles>
            <profile id="70f1-177a-169d-2b6f" name="Ojo de halcón" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira obtiene la regla especial Francotirador con todas sus armas de disparo con la regla especial Lluvia de flechas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7f33-a6b2-35ca-ac2b" name="Francotirador" hidden="false" targetId="8fa0-a4f6-e454-dbfe" type="rule"/>
