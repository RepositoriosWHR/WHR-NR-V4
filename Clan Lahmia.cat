            <profile id="e361-3c2b-d5e8-85d5" name="Estandarte Real de Lahmia" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen +1 Ataque. Además el portador obtiene la regla especial Tozudez.</characteristic>
              </characteristics>
