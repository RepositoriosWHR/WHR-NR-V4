          </constraints>
          <profiles>
            <profile id="211e-1fc7-5ac7-7b3d" name="Camafeo del escarabajo negro" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene un bonificador de +1 a sus tiradas para recuperar heridas por su regla especial Vampiro; además, si tiene éxito, recuperará todas las heridas que hubiese sufrido previamente durante la batalla en lugar de sólo una. Por último, cada vez que el portador sufra una herida como resultado de fallar un chequeo de desmoralización por su regla especial Inestable, tira 1D6: con cada resultado de 5+, una de esas heridas será cancelada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="9cf5-f735-721c-a710" name="Estupidez" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
