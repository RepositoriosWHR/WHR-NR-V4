                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Cuando la vampira declare un Desafío, éste no puede ser rechazado y puede elegir qué personaje enemigo aceptará su Desafío (esto tiene prioridad sobre la regla especial Orgullo marcial).</characteristic>
                  </characteristics>
