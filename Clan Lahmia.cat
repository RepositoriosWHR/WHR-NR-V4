          <profiles>
            <profile id="d342-24a9-87e5-b570" name="Abanico de cuchillas" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con este arma se resuelven con la regla especial Impactos múltiples (1D6); sin embargo, dichos impactos se resolverán con un penalizador de -1 a la Fuerza, y la fuerza de esos impactos nunca puede
ser superior a 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7708-ea2c-eaca-00d7" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="487e-2766-b875-979a" name="Impactos múltiples (1D6)" hidden="false" targetId="96dd-7015-c4ab-a243" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f79c-4e88-248d-3e64" name="Látigo de la cobra negra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5ec7-6567-9404-8665" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b00f-30f4-ece9-b46a" type="max"/>
          </constraints>
          <profiles>
            <profile id="97ae-458e-3272-457f" name="Látigo de la cobra negra" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador obtiene un bonificador de +2 a su Iniciativa (hasta un máximo de 10) en combate cuerpo a cuerpo, y sus ataques se resolverán con las reglas especiales Ataques envenenados y Poder de penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="21e6-f0b1-6b99-03a2" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="feb4-fd34-a396-5f2c" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
