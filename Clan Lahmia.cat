      </constraints>
      <rules>
        <rule id="bdcc-2267-26d5-77f1" name="Lanzavirotes de hueso" hidden="false">
          <description>Dispara como un Lanzavirotes con un alcance de 48”; sus impactos se resuelven con F6, no permiten tirada de salvación por armadura y tienen la regla especial Heridas múltiples (1D3); también atraviesa filas. Además, los disparos del Lanzavirotes de hueso cuentan con la regla especial Ataques mágicos. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6d0b-48b3-95e9-d5a1" name="No Muerto (1D3)" hidden="false" targetId="d525-40e8-3c14-6012" type="rule"/>
