            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7670-35b0-27c0-7730" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="25a1-8cab-bca7-07a4" type="min"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="28fd-8f53-4819-348f" name="Esplendor ancestral" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e183-52e1-c9ff-8932" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8171-4306-6261-d9e9" type="min"/>
              </constraints>
              <profiles>
                <profile id="67c5-e7df-08cb-80dd" name="Esplendor ancestral" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Resta 1 a la Fuerza de todos los impactos contra la vampira.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
