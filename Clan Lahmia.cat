    <selectionEntry id="1940-600c-e649-edc2" name="Condesa vampira Lahmia" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="377a-e848-afd9-05b8" name="Magia Condesa vampira Lahmia" hidden="false">
          <description>Puede convertirse en hechicero de nivel 1 por +30 puntos. Puede elegir sus hechizos de uno (y solo uno) de los Saberes de la Muerte, las Sombras, Magia Oscura o Nigromancia.</description>
        </rule>
      </rules>
