            <selectionEntry id="8e62-960d-9e5f-49df" name="Festín de sangre" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2e1f-3b6a-0559-72cb" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3c54-ffb6-8ebd-5275" type="min"/>
              </constraints>
              <profiles>
                <profile id="af47-cd6e-68c3-011c" name="Festín de sangre" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira obtiene un bonificador de +2 a sus tiradas para ver si recupera heridas al causarlas por su regla especial Vampiro (es decir, por cada herida que cause en combate cuerpo a cuerpo, recuperará una herida con un resultado de 3+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="a98e-047d-ddfc-6169" name="Dominación" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="03f4-3a5e-9606-314a" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aee7-039e-631e-8701" type="min"/>
              </constraints>
              <profiles>
                <profile id="30d1-28d8-c8c4-ded5" name="Dominación" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Al inicio de cada fase de combate, selecciona una miniatura enemiga en contacto peana con peana con la vampira, que deberá efectuar un chequeo de Liderazgo. Si lo falla, no podrá atacar este turno y todos los ataques que se dirijan contra él impactarán automáticamente. </characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="36b6-e9e4-145a-3a04" name="Hipnotismo" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3c0d-1e75-be04-d885" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="364c-76e8-1b41-33c5" type="min"/>
              </constraints>
              <profiles>
                <profile id="4791-ee9d-faba-9c93" name="Hipnotismo" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">En un desafío, los oponentes deberán repetir todas sus tiradas para impactar exitosas contra la vampiresa.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
