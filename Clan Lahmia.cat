      <selectionEntries>
        <selectionEntry id="a064-69ee-e326-04c7" name="Arco de Djaf" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="14e0-bdf8-7f4f-67c2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1fb7-085e-cf01-43dd" type="max"/>
          </constraints>
          <profiles>
            <profile id="659d-7b01-1a42-72c0" name="Arco de Djaf" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco Lahmiano. Los disparos de este arco se resuelven como si fuese un lanzavirotes (F6, Heridas múltiples [1D3], no permite tiradas de salvación por armadura, Atraviesa filas) pero con un alcance de 24”; puede mover y disparar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1fd1-8539-3188-3693" name="Arco lahmiano" hidden="false" targetId="c2af-c6b6-09d2-be2a" type="profile"/>
