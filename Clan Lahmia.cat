            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c0d6-bbf8-85e9-a859" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6e1a-b35d-0d83-c9ca" type="max"/>
          </constraints>
          <profiles>
            <profile id="c803-3ad6-92a4-bf6e" name="Hipnotismo" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">En un desafío, los oponentes deberán repetir todas sus tiradas para impactar exitosas contra la vampiresa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="5eb1-3c00-722f-c8b7" name="Dominación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="955e-fc26-b59b-d089" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="575f-b456-351f-b7c5" type="max"/>
          </constraints>
          <profiles>
            <profile id="54be-d78c-99ee-33ca" name="Dominación" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Al inicio de cada fase de combate, selecciona una miniatura enemiga en contacto peana con peana con la vampira, que deberá efectuar un chequeo de Liderazgo. Si lo falla, no podrá atacar este turno y todos los ataques que se dirijan contra él impactarán automáticamente. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="81bd-0696-e812-35d9" name="Festín de sangre" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d171-7975-9e78-87da" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="fd7a-be9c-154e-079e" type="max"/>
          </constraints>
          <profiles>
            <profile id="5677-e9dd-85c3-f90a" name="Festín de sangre" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira obtiene un bonificador de +2 a sus tiradas para ver si recupera heridas al causarlas por su regla especial Vampiro (es decir, por cada herida que cause en combate cuerpo a cuerpo, recuperará una herida con un resultado de 3+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
