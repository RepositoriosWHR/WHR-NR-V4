          <selectionEntries>
            <selectionEntry id="ad37-b5a7-4773-1f26" name="Nagadron, El Devorador" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9b46-323f-e641-42ad" type="max"/>
              </constraints>
              <profiles>
                <profile id="6ab0-85d9-8ace-8066" name="Nagradon, El Devorador" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                  <characteristics>
                    <characteristic name="M" typeId="4d23232344415441232323">8</characteristic>
                    <characteristic name="HA" typeId="575323232344415441232323">4</characteristic>
                    <characteristic name="HP" typeId="425323232344415441232323">0</characteristic>
                    <characteristic name="F" typeId="5323232344415441232323">6</characteristic>
                    <characteristic name="R" typeId="5423232344415441232323">6</characteristic>
                    <characteristic name="H" typeId="5723232344415441232323">6</characteristic>
                    <characteristic name="I" typeId="4923232344415441232323">3</characteristic>
                    <characteristic name="A" typeId="4123232344415441232323">6</characteristic>
                    <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
                    <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                    <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
                    <characteristic name="Tipo" typeId="5479706523232344415441232323">Monstruo</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="3c9e-d830-2826-35fb" name="El Devorador" hidden="false">
                  <description>Cada vez que Nagadron cause una herida en combate cuerpo a cuerpo a un enemigo, tira 1D6: si obtienes un resultado de 4+, Nagadron puede recuperar una herida que hubiese sufrido previamente durante la batalla.</description>
                </rule>
                <rule id="5b47-ae77-94f8-0470" name="Interacciones" hidden="false">
                  <description>Ten en cuenta que ir montada en Nagadron no reuce la Esquiva de Neferata (que seguirá siendo de 5+). Ten en cuenta, también, que la tirada de Regeneración se realiza después de determinar si el Ruibí de Lahmia anula las heridas causadas a Neferata.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="2811-87aa-acaf-4659" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
                <infoLink id="dbd5-fb73-710a-6d1f" name="Regeneración (4+)" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
