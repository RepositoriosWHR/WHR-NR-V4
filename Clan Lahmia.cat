    <selectionEntryGroup id="ec6d-ffe1-d848-bb1f" name="Artefactos arcanos. Clan Lahmia" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5ab6-119a-0c2e-d6e2" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1aed-a311-b570-a536" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="0a20-b46f-4d3b-b855" name="Familiar felino" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b582-4f03-8324-5811" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="57a7-4908-3e7f-c93d" type="max"/>
          </constraints>
          <profiles>
            <profile id="8125-bcfd-32d4-1771" name="Familiar felino" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">La portadora obtiene un bonificador de +1 a sus tiradas de canalizar y puede lanzar el hechizo Vuelo de bruja del saber de Magia Oscura como si lo conociese; ten en cuenta que no conoce el hechizo, no puede perderlo, no tiene la regla del saber de Magia Oscura ni tampoco le limita el acceso al hechizo identificativo del saber que conozca. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
            <profile id="8706-389a-d225-9757" name="[2] - Vuelo de bruja" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">8+/13+</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">Lanzador</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo al propio lanzador. El lanzador realiza inmediatamente un movimiento como si tuviera la regla especial Volar (10). El lanzador puede decidir realizar una carga o marcha con este movimiento. Si el lanzador tiene Potencia de unidad de 5+, la dificultad del hechizo será de 13+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a123-a529-bb54-4f51" name="Talismán negro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5dec-1926-791a-3442" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f189-f777-564f-2a5b" type="max"/>
          </constraints>
          <profiles>
            <profile id="4eb5-dad0-3c57-bdc2" name="Talismán negro" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite a su portador guardar un dado de Energía o Dispersión no utilizado al final de cualquier fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="71c9-bda1-54fb-0e08" name="El libro de la Serpiente" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="43e8-d7b8-888e-3975" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="644d-1446-a53a-d5ac" type="max"/>
          </constraints>
          <profiles>
            <profile id="5c23-c97e-0275-d844" name="El libro de la Serpiente" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de daño directo con un alcance de 18” que causa 3D6 impactos de F2; los resultados de 6 en las tiradas para herir no permiten tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="9a4e-5f41-d757-ebaa" name="Estandartes mágicos. Clan Lahmia" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="88af-2ac7-19e1-0868" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="25c4-b15d-cb3c-4e13" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="917a-723f-25f9-b5b7" name="Pabellón del Áspid" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="43da-6331-bf31-7fd9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7b07-738c-c3ec-13b2" type="max"/>
          </constraints>
          <profiles>
            <profile id="889b-b71a-6b1e-d0dd" name="Pabellón del Áspid" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas de la unidad que disparen utilizando flechas áspid pueden repetir los resultados de 1 en sus tiradas para impactar con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="36f9-f34c-f69f-cad7" name="Estandarte de los lamentos" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2a89-9764-c5dc-b31d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="bf63-d4b6-a34e-5849" type="max"/>
          </constraints>
          <profiles>
            <profile id="f106-8507-c1c3-2759" name="Estandarte de los lamentos" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los chequeos de Miedo y Terror provocados por la unidad portadora se efectuarán con 3D6 y descartando el resultado más bajo. </characteristic>
              </characteristics>
            </profile>
