    <selectionEntry id="30d9-68cc-6efa-739c" name="Sacerdotisa del Templo de la Sangre" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="998e-034a-e09d-3fa1" name="El Templo de la Sangre" hidden="false">
          <description>Una Sacerdotisa conoce todas las plegarias del Templo de la Sangre, y puede lanzar una de ellas por fase de magia propia con nivel de energía 4, o hasta dos de ellas por fase de magia con nivel de energía 2 cada una.</description>
        </rule>
        <rule id="efd5-c2b0-0bcc-e9a1" name="Trono sangriento" hidden="false">
          <description>Si la Sacerdotisa monta un Trono del Aquelarre aumenta en 6” el alcance de todas las plegarias que lance, y puede utilizar su regla Sacerdote con el Cuenco de las visiones.</description>
        </rule>
      </rules>
