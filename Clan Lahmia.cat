        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Mover o disparar, Poder de penetración, Francotirador.</characteristic>
      </characteristics>
    </profile>
    <profile id="5798-9ecc-bdfc-a3b6" name="Pistola de repetición" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">10&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Disparo rápido, Combate, Poder de penetración, Disparos múltiples (3).</characteristic>
      </characteristics>
    </profile>
    <profile id="9966-1d45-4fc6-cdb6" name="Arcabuz de repetición" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Mover o disparar, Poder de penetración, Disparos múltiples (3).</characteristic>
      </characteristics>
    </profile>
    <profile id="e383-a73d-c288-6f95" name="Maza ogra" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Portador</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración</characteristic>
      </characteristics>
    </profile>
    <profile id="0394-19bc-3e0c-3403" name="Pistola ogra" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido. Del mismo modo que una pistola, una pistola ogra puede usarse como un arma de mano, luchando en el primer turno con la F del arma y poder de penetración con un único ataque.</characteristic>
      </characteristics>
    </profile>
    <profile id="ecaa-5926-4c88-8d24" name="Puño de hierro" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Al inicio de cada combate (no de cada ronda), una unidad de ogros con puño de hierro ha de decidir si los utiliza como si fuesen escudos o como si fuesen armas de mano adicionales.</characteristic>
      </characteristics>
    </profile>
    <profile id="ff39-c6ee-0dac-4e18" name="Ristra de pistolas ogras" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Disparos múltiples (2)paros múltiples (2). Del mismo modo que una ristra de pistolas, la ristra de pistolas ogras puede utilizarse en combate cuerpo a cuerpo, y cuenta como arma de mano adicional, y todos los ataques son con la F del arma y Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile id="867a-609d-682f-f0ac" name="Espada cayetana" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1I, +1HA, Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile id="3189-6091-fb0c-7cc8" name="Arco funerario" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Lluvia de flechas, Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile id="17b5-d8ac-50df-0551" name="Arma de mano funeraria" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mñagicos, Golpe letal, Arma de mano: Se considera un Arma de mano a todos los efectos y puede utilizarse en combinación con un Escudo para realizar Parada, siguiendo las reglas habituales.</characteristic>
      </characteristics>
    </profile>
    <profile id="d98a-e208-ad83-300a" name="Armas emparejadas funerarias" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Ataque, Ataques mñagicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile id="0b30-2e0a-bd29-d063" name="Lanza de caballería funeraria" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataque rápido, Ataques mágicos, Golpe letal. Sólo se puede usar en el turno de carga, en fases de combate posteriores (o si la unidad recibe una carga) se debe luchar con cualquier otro arma que se posea.</characteristic>
      </characteristics>
    </profile>
    <profile id="25e0-4608-7dbe-117f" name="Mayal funerario" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Agotamiento, Ataques mágicos, Golpe letal.</characteristic>
      </characteristics>
    </profile>
    <profile id="839b-3891-82b1-1cf8" name="Alabarda funeraria" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Luchar con filas adicionales (1), Ataques mágicos, Golpe letal.</characteristic>
      </characteristics>
    </profile>
    <profile id="4308-f2c0-de57-2382" name="Arma a dos manos funerarias" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Lenta, Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile id="f1c7-d57e-c924-b978" name="Arco compuesto" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">30&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Lluvia de flechas, Poder de penetración, Empalar: Los resultados naturales de 6 para herir con estas armas se resuelven con la regla especial Heridas múltiples (1D3).</characteristic>
      </characteristics>
    </profile>
    <profile id="bd72-fdd8-0f24-cbe8" name="Arco del desierto" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">48&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Atraviesa filas, Heridas múltiples (1D3), niega la tirada de salvación por armadura</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
