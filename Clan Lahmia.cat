          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a7b7-3235-ff1b-276e" name="Velocidad sobrenatural" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d77f-2f28-35b1-8853" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c858-927d-a0c6-c6cd" type="max"/>
          </constraints>
          <profiles>
            <profile id="b1c1-add0-04ec-3257" name="Velocidad sobrenatural" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Si la vampira (o su unidad) declaran una carga, el enemigo no podrá declarar Aguantar y disparar o Disparar y huir como reacción a la carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4459-bfc0-3b62-38d5" name="Señora de los mortales" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="79da-f128-e9b2-d8a6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e850-f70c-3163-6f6e" type="max"/>
          </constraints>
          <profiles>
            <profile id="8707-57de-56f4-ea3a" name="Señora de los mortales" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Tu ejército puede incluir hasta 2 unidades básicas y hasta 1 héroe (indicado entre paréntesis en cada caso) del libro de ejército del Imperio (Capitán o Hechicero), de Bretonia (Paladín, Castellano o Bardo), de Kislev (Boyardo o Atamán), de Estalia (Capitán, Maestro esgrimista o Mago) o de Mercenarios (Capitán o Hechicero). Contarán como opciones de Unidad básica. Obtienen las reglas especiales ¡Están vivos! (esta regla sirve meramente como un recordatorio de que las miniaturas con esta regla especial no están sujetos a la regla especial No muertos. Sin embargo, un personaje no muerto puede unirse a ellas. Mientras suceda esto, la unidad será Inmune a la psicología, pero el personaje perderá su regla Inestable mientras queden miniaturas vivas en la unidad; deberá huir con su unidad si esta huye, pero se reagrupará automáticamente al final de la fase en la que huyó; ten en cuenta que deben chequear Pánico por muerte del General) e Inmunes a Miedo, y elegirán sus estandartes mágicos del Reglamento o de este libro de ejército. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="aa48-3f9a-df41-8db0" name="Guardiana de los antiguos ritos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c86a-6230-6d73-0546" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="69d3-cf90-791d-48f8" type="max"/>
          </constraints>
          <profiles>
            <profile id="437b-89c2-e568-3e59" name="Guardiana de los antiguos ritos" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Una vez por fase de magia propia la vampira puede utilizar como objeto portahechizos con nivel de energía 3 un hechizo de potenciación que puede lanzarse sobre una unidad con la regla especial Constructo a 18” o menos de la vampira. La unidad restaura inmediatamente un dado de invocación. Si quien posee este poder es una Sacerdotisa del templo de la sangre puede hacer uso de su regla especial Sacerdote para lanzar este portahechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="af5a-338b-5ff1-2b94" name="Experta embaucadora" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e6a4-d676-efd4-df75" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d5f4-d6cf-7842-284a" type="max"/>
          </constraints>
          <profiles>
            <profile id="fc99-14d8-0dfa-676b" name="Experta embaucadora" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Al principio de cada ronda de combate cuerpo a cuerpo elige a una miniatura que esté en contacto peana con peana con la vampira y que no sea una montura: esa miniatura deberá superar un chequeo de Liderazgo (con su Liderazgo base, no podrá usar la regla Presencia inspiradora ni ¡Ni un paso atrás!). Si falla el chequeo la miniatura habrá caído bajo los encantos de la vampira y realizará sus ataques contra su propia unidad. En caso de que la miniatura no vaya en una unidad, este poder no tendrá efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c4e6-4e23-f8a2-c24b" name="Estirpe inmortal" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="faab-e0cb-9705-b1ca" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3a78-5f95-68ba-df4e" type="max"/>
          </constraints>
          <profiles>
            <profile id="321a-6275-efa6-1d3e" name="Estirpe inmortal" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira es inmune a los efectos de las reglas especiales Golpe letal y Golpe letal heroico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b9ad-8df1-c999-0231" name="Don del Áspid" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5da3-f792-5955-5be1" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ff18-317d-26ed-595b" type="max"/>
          </constraints>
          <profiles>
            <profile id="93d2-1e9a-ef64-80b2" name="Don del Áspid" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira obtiene la regla especial Ataques envenenados; además, sus Ataques envenenados exitosos (tanto en cuerpo a cuerpo como con proyectiles) se resolverán con la regla especial Heridas múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="cc11-09c1-cc88-9ae8" name="Poderes vampíricos del clan Lahmia. Poder mayor" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ade5-2219-10ec-b925" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="e7e4-ef92-4178-2dba" name="Criatura de la noche" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9c52-40f6-bdd7-08dd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e12d-81b4-f542-9ffa" type="max"/>
          </constraints>
          <profiles>
            <profile id="6428-6559-a4a9-c8c9" name="Criatura de la noche" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. En combate cuerpo a cuerpo y con proyectiles, la vampira sólo puede ser impactada con resultados naturales de 6, sin tener en cuenta otros modificadores. No tiene efecto alguno contra ataques que no tiren para impactar o que impacten automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="60.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="75eb-2083-accb-3327" name="Maestra de la ilusión" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="71a5-6d3a-10ce-ab4b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cbb8-ea65-9638-245d" type="max"/>
          </constraints>
          <profiles>
            <profile id="93cb-e0a2-7603-1efa" name="Maestra de la ilusión" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Cuando la vampira declare un Desafío, éste no puede ser rechazado y puede elegir qué personaje enemigo aceptará su Desafío (esto tiene prioridad sobre la regla especial Orgullo marcial).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="809a-56d1-b401-1090" name="Forma espectral" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="172b-e2eb-8b29-86e1" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ae64-31d3-c0aa-53d3" type="max"/>
          </constraints>
          <profiles>
            <profile id="48d8-cf6b-265c-4e3c" name="Forma espectral" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. La vampira obtiene la regla especial Etéreo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d27c-0ee1-7388-c693" name="Seducción" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="744c-8f91-b09a-9a92" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a9cf-e316-b82d-9d3a" type="max"/>
          </constraints>
          <profiles>
            <profile id="5a48-afc7-3715-ba32" name="Seducción" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Al inicio de cualquier fase de combate cuerpo a cuerpo propia, puedes elegir una miniatura enemiga que no tenga la regla especial Inmune a psicología en contacto peana con peana con la vampira. Esa miniatura deberá efectuar un chequeo de Liderazgo con su valor básico sin modificar (no puede utilizarse ni la Presencia inspiradora ni ¡Ni un paso atrás!). Si lo supera, no pasará nada; pero si lo falla, esa miniatura pasará a estar controlada por el jugador vampiro durante el resto de la partida. Si se encontraba en una unidad, debe separarse inmediatamente de ella. Este poder puede utilizarse una vez por fase de combate cuerpo a cuerpo propia, pero tan sólo se puede controlar una miniatura enemiga durante la batalla (es decir, puede usarse las veces que sean necesarias hasta que tenga éxito, momento en el cual no podrá usarse más). </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="462b-87f4-1326-cf47" name="Poderes vampíricos del clan Lahmia. Poder menor. General" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ef91-ed63-b84b-9129" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="ecf2-0ee4-02ee-04b7" name="Alianza impía" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8ea1-1c65-c1e9-9acb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="19e3-d5fd-7b6e-c02c" type="max"/>
          </constraints>
          <profiles>
            <profile id="5bdd-f95c-dc8a-7dd6" name="Alianza impía" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Sólo general del ejército. El ejército pasa a considerarse un ejército Neutral (deja de ser un ejército de la Destrucción), y su alianza con los ejércitos de Imperio, Bretonia, Kislev, Mercenarios, Norsca, Nippón, Catay, Arabya, Middenland, Halflings de la Asamblea, Tren de Artillería de Nuln, Chevaliers de Lyonesse, Estalia, Marienburgo y cualquier otro ejército con la clave humanos mejora en un paso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
