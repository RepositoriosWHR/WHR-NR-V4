            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cdb2-973d-b00a-000e" type="max"/>
          </constraints>
          <profiles>
            <profile id="4d72-3769-2910-3072" name="Esplendor ancestral" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Resta 1 a la Fuerza de todos los impactos contra la vampira.</characteristic>
              </characteristics>
            </profile>
          </profiles>
