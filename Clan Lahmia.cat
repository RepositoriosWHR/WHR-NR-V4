                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3cd6-2e3f-370c-5e07" type="min"/>
              </constraints>
              <profiles>
                <profile id="7a8e-e20b-d8d8-3474" name="Espada larga Catayana" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Se trata de un arma que requiere ambas manos. Al luchar con ella, proporciona a Naaima un bonificador de +1 a su Iniciativa y Ataques, y sus impactos se resuelven con +1 Fuerza y la regla especial Poder de penetración.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="b1e0-61f8-6681-e24f" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="665d-8998-7d7f-9557" name="Requiere ambas manos" hidden="false" targetId="41a9-6192-62dd-4867" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="4cfa-1b2f-ba25-854f" name="Abanico de jade" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f71f-c6bb-d0d6-5f01" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6513-a8f0-23d7-7ac7" type="min"/>
              </constraints>
              <profiles>
                <profile id="7cb4-60ab-1441-931a" name="Abanico de jade (Definición)" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Se trata de un arma de disparo con el perfil indicado. Además, una vez por batalla puede utilizarse como objeto portahechizos con nivel de energía 12: el hechizo contenido es el  Encantamiento de la tormenta de cráneos de Usirian, del Saber de Nehekhara, en su versión no potenciada.</characteristic>
                  </characteristics>
                </profile>
                <profile id="f916-9ada-9618-b762" name="Abanico de jade (Perfil)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">18&quot;</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Ataques envenenados, Disparo rápido, Disparos múltiples (2D6), Poder de penetración.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="8e17-09dc-4fcc-a09a" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink id="176a-5a3e-29bd-85b2" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink id="3864-86e1-d47c-9682" name="Disparo rápido" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
                <infoLink id="8d60-6d85-dc04-c2c4" name="Disparos múltiples" hidden="false" targetId="fc7e-40e6-a7aa-4530" type="rule">
