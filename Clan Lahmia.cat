            <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
            <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
            <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
            <characteristic name="Tipo" typeId="5479706523232344415441232323">Monstruo</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="8a44-0fd5-a276-3582" name="Monstruo de hueso" hidden="false">
          <description>El personaje que lo monte obtiene un bonificador adicional de +2 a su tirada de salvación por armadura, y puede repetir sus tiradas de salvación por armadura fallidas contra impactos de Fuerza 5 o inferior.</description>
        </rule>
        <rule id="cc78-fc02-86bb-be7c" name="Aliento mortal" hidden="false">
          <description>Se trata de un  Arma de aliento: cualquier miniatura impactada por esta será herida con un resultado de 4+, sin importar su Resistencia. Estas heridas no permiten tirada de salvación por armadura.</description>
        </rule>
        <rule id="e856-4fb0-951f-f1a1" name="Dragón de huesoEmbebido en magia" hidden="false">
          <description>Un Dragón esqueleto tiene las reglas especiales Ataques mágicos y Resistencia mágica (1). Un personaje montado en dragón de hueso también obtiene la clave dragón.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f8ce-6b15-5ba4-db3f" name="No Muerto (1)" hidden="false" targetId="467a-3f64-3c89-09ba" type="rule"/>
